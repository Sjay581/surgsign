<Window x:Class="SurgSignDesktop.Views.HandoffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handoff QR"
        Height="720" Width="620"
        MinHeight="640" MinWidth="560"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Shift Handoff"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0">
                <Run Text="{Binding ServiceName, Mode=OneWay}" />
                <Run Text=" • " />
                <Run Text="{Binding Shift, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,16,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Image Source="{Binding QrImage}"
                   Width="460" Height="460"
                   Stretch="Uniform" />
        </Border>

        <TextBlock Grid.Row="2"
                   Text="{Binding Summary}"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Copy payload"
                    Click="OnCopyClicked"
                    Style="{StaticResource BaseButton}"
                    Margin="0,0,10,0" />
            <Button Content="Done"
                    Click="OnDoneClicked"
                    Style="{StaticResource AccentButton}"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
