<Window x:Class="SurgSignDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SurgSignDesktop.ViewModels"
        xmlns:views="clr-namespace:SurgSignDesktop.Views"
        Title="SurgSign Desktop"
        Height="720" Width="1200"
        MinHeight="600" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SurgSign"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Service:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="24,0,8,0" />
                    <TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"
                             Width="200"
                             VerticalAlignment="Center"
                             Style="{StaticResource BaseTextBox}" />
                    <TextBlock Text="Shift:"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="24,0,8,0" />
                    <Border Background="{StaticResource Surface2Brush}"
                            CornerRadius="6"
                            Padding="3"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="AM"
                                    Command="{Binding ToggleAmCommand}"
                                    Width="50" Height="26"
                                    Margin="0,0,3,0"
                                    Style="{StaticResource BaseButton}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4" />
                                    </Style>
                                </Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAm}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AMBrush}" />
                                                <Setter Property="Foreground" Value="#FF0B0F14" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="PM"
                                    Command="{Binding TogglePmCommand}"
                                    Width="50" Height="26">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPm}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource PMBrush}" />
                                                <Setter Property="Foreground" Value="#FF0B0F14" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ Add Patient"
                            Command="{Binding AddPatientCommand}"
                            Style="{StaticResource BaseButton}"
                            Margin="0,0,8,0" />
                    <Button Content="Handoff"
                            Command="{Binding HandoffCommand}"
                            Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Patient list -->
            <views:PatientListView Grid.Column="0"
                                   DataContext="{Binding}" />

            <!-- Edit pane -->
            <Border Grid.Column="1"
                    Background="{StaticResource BackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <!-- Empty state -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPatient}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="No patient selected"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="16"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Add a patient or select one from the list."
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,16" />
                        <Button Content="+ Add Patient"
                                Command="{Binding AddPatientCommand}"
                                Style="{StaticResource AccentButton}"
                                HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Edit form -->
                    <views:PatientEditView DataContext="{Binding}">
                        <views:PatientEditView.Style>
                            <Style TargetType="views:PatientEditView">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPatient}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PatientEditView.Style>
                    </views:PatientEditView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
